@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');


/* =========================
   ROOT VARIABLES
========================= */


:root{

    --primary:#00eaff;

    --secondary:#0066ff;

    --dark:#050816;

    --dark-light:#0b1026;

--glass:rgba(255,255,255,0.12);

    --glass-hover:rgba(255,255,255,0.12);

    --border:rgba(255,255,255,0.15);

    --text:white;

    --muted:#9ca3af;

    --danger:#ff3344;

    --success:#00ff99;

    --shadow:
    0 0 40px rgba(0,234,255,.15);

}





/* =========================
   RESET
========================= */


*{

    margin:0;

    padding:0;

    box-sizing:border-box;

    font-family:'Poppins',sans-serif;

}



html{

    scroll-behavior:smooth;

}


body{

    min-height:100vh;

    background:
    radial-gradient(circle at 20% 20%, rgba(0,234,255,.25), transparent 30%),
    radial-gradient(circle at 80% 30%, rgba(0,102,255,.25), transparent 35%),
    linear-gradient(
        135deg,
        #050816,
        #0b1026
    );

    color:white;

    overflow-x:hidden;

}



/* =========================
   SCROLLBAR
========================= */


::-webkit-scrollbar{

    width:8px;

}



::-webkit-scrollbar-track{

    background:#050816;

}



::-webkit-scrollbar-thumb{

    background:#00eaff;

    border-radius:20px;

}







/* =========================
   LOADER
========================= */


.app-loader{

    position:fixed;

    inset:0;

    background:#050816;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:20px;

    z-index:9999;

    transition:.5s;

}



.loader-circle{

    width:60px;

    height:60px;

    border-radius:50%;

    border:5px solid rgba(255,255,255,.1);

    border-top-color:#00eaff;

    animation:spin 1s linear infinite;

}



@keyframes spin{

    to{

        transform:rotate(360deg);

    }

}







/* =========================
   MOBILE HEADER
========================= */


.mobile-header{

    display:none;

}







/* =========================
   MAIN APPLICATION
========================= */


.settings-app{

    width:95%;

    max-width:1500px;

    min-height:90vh;

    margin:40px auto;

    display:flex;

    background:var(--glass);

    backdrop-filter:blur(25px);

    border:1px solid var(--border);

    border-radius:30px;

    overflow:hidden;

    box-shadow:var(--shadow);

}







/* =========================
   SIDEBAR
========================= */

.settings-sidebar{
      position: relative;
       overflow: hidden;
    width:300px;

    flex-shrink:0;

    padding:30px 20px;

    border-right:1px solid rgba(255,255,255,.15);

background:
linear-gradient(
145deg,
rgba(255,255,255,.20),
rgba(255,255,255,.06)
);

backdrop-filter:blur(45px);
-webkit-backdrop-filter:blur(45px);

    border-radius:25px;

    box-shadow:
    0 25px 80px rgba(0,0,0,.45),
    inset 0 1px 20px rgba(255,255,255,.08);

    display:flex;

    flex-direction:column;

}


.settings-sidebar::before{

content:"";

position:absolute;

top:0;
left:0;

width:100%;
height:100%;

background:
linear-gradient(
120deg,
rgba(255,255,255,.25),
transparent 40%
);

pointer-events:none;

opacity:.4;

}


.sidebar{

    position:fixed;

    left:20px;
    top:20px;

    width:260px;

    height:calc(100vh - 40px);


    background:var(--glass);

    backdrop-filter:blur(25px);


    border:1px solid var(--border);

    border-radius:25px;


    padding:25px;


    box-shadow:
    0 0 40px rgba(0,234,255,.15);


    z-index:1000;

}



.logo{

    display:flex;

    align-items:center;

    gap:15px;


    font-size:28px;

    font-weight:800;


    margin-bottom:40px;

}



.logo i{

    color:var(--primary);

    filter:
    drop-shadow(0 0 15px var(--primary));

}



.menu{

    list-style:none;

}



.menu li{

    margin:10px 0;

}



.nav-item{

       position:relative;

    overflow:hidden;
     display:flex;

    align-items:center;

    gap:15px;


    padding:12px;


    border-radius:15px;


    color:#aaa;


    text-decoration:none;


    transition:.3s;

}

.nav-item::before{

    content:"";

    position:absolute;

    left:0;

    top:0;

    width:0%;

    height:100%;


    background:

    linear-gradient(
        90deg,
        rgba(0,234,255,.25),
        rgba(0,102,255,.25)
    );


    transition:.4s;


    z-index:-1;

}
.nav-item:hover::before{

    width:100%;

}



.nav-item:hover{

    transform:translateX(10px);

    color:white;

}

.nav-item i{

    width:25px;
    transition:.3s;
    color:var(--primary);

}

.nav-item:hover i{

    transform:scale(1.25) rotate(8deg);

    color:white;

}


@keyframes activePulse{

    from{

        box-shadow:
        0 0 15px rgba(0,234,255,.3);

    }


    to{

        box-shadow:
        0 0 35px rgba(0,234,255,.7);

    }

}
.logo-icon{
    animation:logoFloat 3s infinite ease-in-out;

}



@keyframes logoFloat{

    0%,100%{

        transform:translateY(0);

    }


    50%{

        transform:translateY(-6px);

    }

}



/* =========================
   NAVIGATION
========================= */


.settings-nav{

    flex:1;

}



.nav-item{

    position:relative;

    overflow:hidden;

    width:100%;

    display:flex;

    align-items:center;

    gap:15px;

    padding:15px 18px;

    margin-bottom:8px;

background:rgba(255,255,255,.04);
    border:none;

    color:#aaa;

    border-radius:15px;

    cursor:pointer;

    font-size:15px;

    transition:.35s;

}

.nav-item::before{

    content:"";

    position:absolute;

    left:-100%;

    top:0;

    width:100%;

    height:100%;

    background:

    linear-gradient(
    90deg,
    rgba(0,234,255,.25),
    rgba(0,102,255,.25)
    );

    transition:.4s;

    z-index:-1;

}


.nav-item:hover::before{

    left:0;

}


.nav-item:hover{

    transform:translateX(8px);

    color:white;

}


.nav-item i{

    color:#00eaff;

    transition:.3s;

}


.nav-item:hover i{

    transform:scale(1.2) rotate(8deg);

}


.nav-item.active{

    background:

    linear-gradient(
    135deg,
    rgba(0,234,255,.25),
    rgba(0,102,255,.25)
    );

    color:white;

    box-shadow:

    0 0 25px rgba(0,234,255,.35);

    animation:navGlow 2s infinite alternate;

}


@keyframes navGlow{

from{

box-shadow:0 0 15px rgba(0,234,255,.3);

}

to{

box-shadow:0 0 35px rgba(0,234,255,.7);

}

}


.danger-link:hover{

    color:#ff3344;

    background:

    rgba(255,51,68,.15);

}

/* =========================
   MAIN CONTENT AREA
========================= */


.settings-main{

    flex:1;

    min-width:0;

    display:flex;

    flex-direction:column;

}




/* =========================
   HEADER
========================= */


.settings-header{

    height:90px;

    padding:20px 35px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    border-bottom:

    1px solid var(--border);

}



.breadcrumb{

    display:flex;

    align-items:center;

    gap:12px;

    color:var(--muted);

    font-size:14px;

}



.breadcrumb i{

    font-size:12px;

}



.breadcrumb strong{

    color:white;

}





.header-actions{

    display:flex;

    align-items:center;

    gap:15px;

}




.settings-search{

    width:280px;

    height:45px;

    display:flex;

    align-items:center;

    gap:12px;

    padding:0 15px;

    background:

    rgba(255,255,255,.06);

    border:1px solid var(--border);

    border-radius:15px;

}



.settings-search i{

    color:var(--primary);

}



.settings-search input{

    width:100%;

    background:none;

    border:none;

    outline:none;

    color:white;

}




.notification-btn{

    width:45px;

    height:45px;

    border-radius:50%;

    border:none;

    background:

    rgba(255,255,255,.08);

    color:white;

    cursor:pointer;

    transition:.3s;

}



.notification-btn:hover{

    background:

    rgba(0,234,255,.2);

    color:var(--primary);

}






.mini-profile{

    display:flex;

    align-items:center;

    gap:12px;

    padding:8px 15px;

    border-radius:15px;

    background:

    rgba(255,255,255,.06);

}



.mini-avatar{

    width:40px;

    height:40px;

    border-radius:50%;

    background:

    linear-gradient(
    45deg,
    var(--primary),
    var(--secondary)
    );

    display:flex;

    justify-content:center;

    align-items:center;

    font-weight:700;

}



.mini-profile h4{

    font-size:14px;

}



.mini-profile p{

    color:var(--muted);

    font-size:12px;

}







/* =========================
   CONTENT
========================= */


.settings-content{

    padding:35px;

    overflow-y:auto;

    height:calc(90vh - 90px);

}



.settings-section{

    display:none;

    animation:

    fadeIn .4s ease;

}



.settings-section.active{

    display:block;

}



@keyframes fadeIn{

    from{

        opacity:0;

        transform:translateY(15px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}






.settings-section h1{

    font-size:32px;

    margin-bottom:8px;

}



.section-description{

    color:var(--muted);

    margin-bottom:30px;

}






/* =========================
   CARDS
========================= */


.settings-card{

    background:

    rgba(255,255,255,.06);

    border:

    1px solid var(--border);

    border-radius:25px;

    padding:30px;

    margin-bottom:25px;

    transition:.3s;

}



.settings-card:hover{

    background:

    var(--glass-hover);

}



.card-header{

    margin-bottom:25px;

}



.card-header h2{

    font-size:22px;

}



.card-header p{

    color:var(--muted);

    font-size:14px;

}






/* =========================
   PROFILE CARD
========================= */


.profile-card{

    display:flex;

    align-items:center;

    gap:25px;

    padding:30px;

    background:

    rgba(255,255,255,.06);

    border-radius:25px;

    margin-bottom:25px;

}



.profile-avatar-area{

    position:relative;

}



.large-avatar{

    width:110px;

    height:110px;

    border-radius:50%;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:45px;

    font-weight:700;

    background:

    linear-gradient(
    45deg,
    var(--primary),
    var(--secondary)
    );

}



.avatar-upload-btn{

    position:absolute;

    bottom:5px;

    right:5px;

    width:35px;

    height:35px;

    border-radius:50%;

    border:none;

    background:#00eaff;

    color:#050816;

    cursor:pointer;

}



.profile-details h2{

    font-size:26px;

}



.profile-details p{

    color:var(--muted);

}



.member-badge{

    display:inline-flex;

    align-items:center;

    gap:8px;

    margin-top:12px;

    padding:8px 15px;

    border-radius:20px;

    background:

    rgba(0,234,255,.15);

    color:var(--primary);

    font-size:13px;

}
/* =========================
   INPUTS
========================= */


.input-grid{

    display:grid;

    grid-template-columns:

    repeat(2,1fr);

    gap:20px;

}



.input-group{

    display:flex;

    flex-direction:column;

    gap:8px;

}



.input-group label{

    font-size:14px;

    color:#ccc;

}



.input-group input,

.big-select{

    width:100%;

    padding:14px 16px;

    border-radius:15px;

    border:

    1px solid var(--border);

    background:

    rgba(0,0,0,.25);

    color:white;

    outline:none;

    transition:.3s;

}



.input-group input:focus,

.big-select:focus{

    border-color:var(--primary);

    box-shadow:

    0 0 15px rgba(0,234,255,.25);

}



.big-select option{

    background:#050816;

    color:white;

}








/* =========================
   INFORMATION ROWS
========================= */


.info-list{

    display:flex;

    flex-direction:column;

}



.info-row{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:18px 0;

    border-bottom:

    1px solid var(--border);

}



.info-row:last-child{

    border-bottom:none;

}



.info-row span{

    color:var(--muted);

}



.info-row strong{

    color:white;

}








/* =========================
   BUTTONS
========================= */


.primary-action,

.secondary-action,

.danger-action{

    border:none;

    padding:13px 22px;

    border-radius:15px;

    cursor:pointer;

    font-weight:600;

    transition:.3s;

}



.primary-action{

    background:

    linear-gradient(
    45deg,
    var(--primary),
    var(--secondary)
    );

    color:white;

}



.secondary-action{

    background:

    rgba(0,234,255,.15);

    color:var(--primary);

    border:

    1px solid rgba(0,234,255,.3);

}



.danger-action{

    background:

    rgba(255,51,68,.15);

    color:#ff6677;

    border:

    1px solid rgba(255,51,68,.3);

}



.primary-action:hover,

.secondary-action:hover,

.danger-action:hover{

    transform:

    translateY(-3px);

}








/* =========================
   SETTING OPTIONS
========================= */


.setting-option{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:20px;

    border-radius:18px;

    background:

    rgba(255,255,255,.04);

    margin-bottom:15px;

}



.setting-option h3{

    font-size:16px;

}



.setting-option p{

    color:var(--muted);

    font-size:13px;

    margin-top:5px;

}







/* =========================
   TOGGLE SWITCH
========================= */


.toggle{

    position:relative;

    width:58px;

    height:30px;

}



.toggle input{

    display:none;

}



.toggle span{

    position:absolute;

    inset:0;

    border-radius:30px;

    background:#555;

    cursor:pointer;

    transition:.3s;

}



.toggle span:before{

    content:"";

    position:absolute;

    width:24px;

    height:24px;

    left:3px;

    bottom:3px;

    background:white;

    border-radius:50%;

    transition:.3s;

}



.toggle input:checked + span{

    background:

    var(--primary);

}



.toggle input:checked + span:before{

    transform:

    translateX(28px);

}
/* =========================
   LEARNING GOALS
========================= */


.goal-options{

    display:flex;

    gap:15px;

    flex-wrap:wrap;

}



.goal-btn{

    padding:14px 25px;

    border-radius:18px;

    border:

    1px solid var(--border);

    background:

    rgba(255,255,255,.05);

    color:white;

    cursor:pointer;

    transition:.3s;

}



.goal-btn:hover,

.goal-btn.active{

    background:

    rgba(0,234,255,.2);

    color:var(--primary);

    border-color:var(--primary);

}






/* =========================
   SUBJECT GRID
========================= */


.subject-grid{

    display:grid;

    grid-template-columns:

    repeat(3,1fr);

    gap:15px;

}



.subject-item{

    cursor:pointer;

}



.subject-item input{

    display:none;

}



.subject-item span{

    display:flex;

    justify-content:center;

    align-items:center;

    padding:15px;

    border-radius:18px;

    background:

    rgba(255,255,255,.05);

    border:

    1px solid var(--border);

    transition:.3s;

}



.subject-item input:checked + span{

    background:

    rgba(0,234,255,.18);

    border-color:

    var(--primary);

    color:

    var(--primary);

}







/* =========================
   SECURITY ITEMS
========================= */


.security-item{

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:20px;

    background:

    rgba(255,255,255,.04);

    border-radius:18px;

    margin-bottom:15px;

}



.security-item h3{

    margin-bottom:5px;

}



.security-item p{

    color:var(--muted);

    font-size:13px;

}







/* =========================
   STATISTICS
========================= */


.stats-grid{

    display:grid;

    grid-template-columns:

    repeat(4,1fr);

    gap:20px;

    margin-bottom:25px;

}



.stat-card{

    padding:25px;

    text-align:center;

    border-radius:22px;

    background:

    rgba(255,255,255,.06);

    border:

    1px solid var(--border);

    transition:.3s;

}



.stat-card:hover{

    transform:

    translateY(-8px);

}



.stat-card i{

    font-size:28px;

    color:

    var(--primary);

    margin-bottom:15px;

}



.stat-card h2{

    font-size:32px;

}



.stat-card p{

    color:var(--muted);

}








/* =========================
   HELP SECTION
========================= */


.help-card{

    display:flex;

    align-items:center;

    gap:20px;

    padding:20px;

    background:

    rgba(255,255,255,.04);

    border-radius:18px;

    margin-bottom:15px;

}



.help-card i{

    font-size:30px;

    color:var(--primary);

}



.help-card div{

    flex:1;

}



.help-card p{

    color:var(--muted);

}








/* =========================
   ABOUT
========================= */


.about-card{

    text-align:center;

}



.about-logo{

    width:90px;

    height:90px;

    margin:auto;

    border-radius:25px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:50px;

    font-weight:800;

    background:

    linear-gradient(
    45deg,
    var(--primary),
    var(--secondary)
    );

}



.about-card p{

    color:var(--muted);

    margin:15px;

}



.version-box{

    display:flex;

    justify-content:center;

    gap:15px;

    padding:15px;

    background:

    rgba(255,255,255,.05);

    border-radius:15px;

}



.about-links{

    margin-top:25px;

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

}



.about-links a{

    color:var(--primary);

    text-decoration:none;

}
/* =========================
   MODAL SYSTEM
========================= */


.modal-overlay{

    position:fixed;

    inset:0;

    background:
    rgba(0,0,0,.65);

    backdrop-filter:
    blur(10px);

    display:flex;

    justify-content:center;

    align-items:center;

    opacity:0;

    visibility:hidden;

    transition:.3s;

    z-index:9998;

}



.modal-overlay.active{

    opacity:1;

    visibility:visible;

}





.modal-box{

    width:90%;

    max-width:500px;

    background:

    rgba(15,20,45,.95);

    border:

    1px solid var(--border);

    border-radius:25px;

    padding:35px;

    position:relative;

    transform:

    translateY(40px)
    scale(.9);

    transition:.3s;

    box-shadow:

    0 0 40px rgba(0,234,255,.25);

}



.modal-overlay.active .modal-box{

    transform:

    translateY(0)
    scale(1);

}





.close-modal{

    position:absolute;

    top:15px;

    right:15px;

    width:35px;

    height:35px;

    border-radius:50%;

    border:none;

    background:

    rgba(255,255,255,.1);

    color:white;

    cursor:pointer;

    transition:.3s;

}



.close-modal:hover{

    background:#ff3344;

    transform:rotate(90deg);

}






.modal-box h2{

    color:var(--primary);

    margin-bottom:15px;

}



.modal-box p{

    color:var(--muted);

    line-height:1.6;

}






/* Modal Buttons */


.modal-actions{

    display:flex;

    justify-content:flex-end;

    gap:15px;

    margin-top:25px;

}





.modal-confirm{

    padding:12px 25px;

    border:none;

    border-radius:15px;

    background:

    linear-gradient(
    45deg,
    var(--primary),
    var(--secondary)
    );

    color:white;

    cursor:pointer;

}





.modal-cancel{

    padding:12px 25px;

    border:none;

    border-radius:15px;

    background:

    rgba(255,255,255,.1);

    color:white;

    cursor:pointer;

}





/* Mobile modal */

@media(max-width:600px){

    .modal-box{

        width:95%;

        padding:25px;

    }


    .modal-actions{

        flex-direction:column;

    }


    .modal-confirm,
    .modal-cancel{

        width:100%;

    }

}
/* =========================
   FULL RESPONSIVE SYSTEM
========================= */


/* TABLETS */

@media(max-width:1100px){


.settings-app{

    width:96%;

}



.settings-sidebar{

    width:250px;

}



.settings-search{

    width:220px;

}



.stats-grid{

    grid-template-columns:
    repeat(2,1fr);

}



.subject-grid{

    grid-template-columns:
    repeat(2,1fr);

}



.input-grid{

    grid-template-columns:
    1fr;

}


}








/* SMALL TABLETS */

@media(max-width:850px){



body{

    align-items:flex-start;

}



.settings-app{

    margin:20px;

    min-height:calc(100vh - 40px);

}


.settings-sidebar{

    position:fixed;

    left:-320px;

    top:20px;

    bottom:auto;

    height:calc(100vh - 40px);

    z-index:999;

    transition:.4s;

    background:rgba(255,255,255,.08);

    backdrop-filter:blur(25px);

    border:1px solid rgba(255,255,255,.15);

    border-radius:25px;

}

.settings-sidebar.open{

    left:20px;

}


.settings-main{

    width:100%;

}



.mobile-header{

    display:flex;

    height:70px;

    align-items:center;

    justify-content:space-between;

    padding:15px 20px;

    background:

    rgba(255,255,255,.05);

    border-bottom:

    1px solid var(--border);

}



.mobile-menu-btn{

    width:45px;

    height:45px;

    border:none;

    border-radius:15px;

    background:

    rgba(0,234,255,.15);

    color:var(--primary);

    font-size:20px;

}



.mobile-logo{

    display:flex;

    align-items:center;

    gap:10px;

    font-size:20px;

    font-weight:700;

}



.mobile-logo span{

    width:35px;

    height:35px;

    display:flex;

    justify-content:center;

    align-items:center;

    border-radius:12px;

    background:

    linear-gradient(
    45deg,
    var(--primary),
    var(--secondary)
    );

}



.settings-header{

    height:auto;

    padding:20px;

    flex-direction:column;

    gap:20px;

    align-items:flex-start;

}



.header-actions{

    width:100%;

    flex-wrap:wrap;

}



.settings-search{

    width:100%;

}



.settings-content{

    padding:20px;

    height:auto;

}



.profile-card{

    flex-direction:column;

    text-align:center;

}



}



 




/* MOBILE PHONES */


@media(max-width:600px){

.settings-app{

   width:100%;

    margin:20px;

    border-radius:25px;

    min-height:calc(100vh - 40px);

    background:transparent;
}


.settings-content{

    padding:15px;

}



.settings-section h1{

    font-size:25px;

}



.settings-card{

    padding:20px;

    border-radius:20px;

}





.header-actions{

    display:grid;

    grid-template-columns:

    1fr 50px;

}



.notification-btn{

    width:45px;

}



.mini-profile{

    grid-column:

    1 / -1;

    width:100%;

}



.profile-avatar-area{

    transform:scale(.9);

}





.setting-option,
.security-item{

    flex-direction:column;

    align-items:flex-start;

    gap:20px;

}





.toggle{

    align-self:flex-end;

}



.stats-grid{

    grid-template-columns:

    1fr;

}



.subject-grid{

    grid-template-columns:

    1fr;

}



.goal-options{

    flex-direction:column;

}



.goal-btn{

    width:100%;

}



.help-card{

    flex-direction:column;

    align-items:flex-start;

}



.help-card button{

    width:100%;

}



.about-links{

    flex-direction:column;

}



.danger-card{

    flex-direction:column;

}



}








/* VERY SMALL DEVICES */

@media(max-width:380px){



.settings-section h1{

    font-size:22px;

}



.large-avatar{

    width:90px;

    height:90px;

}



.stat-card h2{

    font-size:25px;

}



}

/* =========================
   STORAGE SECTION
========================= */


.storage-bar{

    width:100%;

    height:18px;

    background:

    rgba(255,255,255,.1);

    border-radius:20px;

    overflow:hidden;

    margin:20px 0;

}



.storage-fill{

    height:100%;

    width:35%;

    border-radius:20px;

    background:

    linear-gradient(
    90deg,
    var(--primary),
    var(--secondary)
    );

    transition:.5s;

}





/* =========================
   DANGER ZONE
========================= */


.danger-title{

    color:#ff6677;

}



.danger-card{

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:25px;

    margin-bottom:20px;

    border-radius:22px;

    background:

    rgba(255,51,68,.08);

    border:

    1px solid rgba(255,51,68,.25);

}



.danger-card h2{

    color:#ff6677;

}



.danger-card p{

    color:var(--muted);

    margin-top:5px;

}








/* =========================
   TOAST NOTIFICATION
========================= */


.toast{

    position:fixed;

    bottom:30px;

    right:30px;

    padding:18px 25px;

    border-radius:18px;

    background:

    rgba(10,20,40,.95);

    border:

    1px solid var(--primary);

    color:white;

    display:flex;

    align-items:center;

    gap:10px;

    transform:

    translateY(120px);

    opacity:0;

    transition:.4s;

    z-index:9999;

    box-shadow:

    0 0 25px rgba(0,234,255,.3);

}



.toast.active{

    transform:

    translateY(0);

    opacity:1;

}



.toast::before{

    content:"✓";

    width:25px;

    height:25px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

    background:

    var(--success);

    color:#050816;

    font-weight:bold;

}







/* =========================
   BUTTON EFFECTS
========================= */


button{

    user-select:none;

}



button:active{

    transform:scale(.96);

}





/* =========================
   GLOW EFFECTS
========================= */


.logo-icon,
.large-avatar,
.about-logo{

    animation:

    glowPulse 3s infinite;

}




@keyframes glowPulse{


0%{

    box-shadow:

    0 0 15px rgba(0,234,255,.3);

}



50%{

    box-shadow:

    0 0 35px rgba(0,234,255,.7);

}



100%{

    box-shadow:

    0 0 15px rgba(0,234,255,.3);

}


}







/* =========================
   MOBILE MENU ANIMATION
========================= */


@media(max-width:850px){


.settings-sidebar.open::after{

    content:"";

    position:fixed;

    inset:0;

    background:

    rgba(0,0,0,.5);

    z-index:-1;

}



.settings-sidebar.open{

    box-shadow:

    20px 0 50px rgba(0,0,0,.5);

}



}






/* =========================
   FINAL POLISH
========================= */


.settings-card,
.profile-card,
.stat-card,
.help-card{

    animation:

    cardEnter .5s ease;

}



@keyframes cardEnter{


from{

    opacity:0;

    transform:

    translateY(20px);

}



to{

    opacity:1;

    transform:

    translateY(0);

}


}
/* REMOVE GLASS EFFECT */

.no-glass .settings-app,
.no-glass .settings-card,
.no-glass .profile-card,
.no-glass .stat-card,
.no-glass .help-card,
.no-glass .mini-profile,
.no-glass .settings-search{

    backdrop-filter:none;

    background:

    rgba(20,25,50,.95);

}



.no-glass .settings-card:hover,
.no-glass .stat-card:hover{

    transform:none;

}
/* MOBILE BACKGROUND FIX */

@media(max-width:600px){

body{

    background:
    radial-gradient(circle at top,#123b70,#050816 65%);

}

}
